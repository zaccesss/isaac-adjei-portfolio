#!/bin/sh
# Strips Co-authored-by lines added by AI coding assistants so commits stay human-only.
# One-time per clone: git config core.hooksPath .githooks
# (Committed path is relative to the repo root.)

MSG_FILE=$1
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

tmp="${MSG_FILE}.$$.tmp"
awk '
  /^Co-authored-by:/ {
    line = tolower($0)
    if (line ~ /cursor/ || line ~ /openai/ || line ~ /anthropic/ || line ~ /claude/ \
        || line ~ /copilot/ || line ~ /chatgpt/ || line ~ /grok/ || line ~ /x-ai/ \
        || line ~ /perplexity/) {
      next
    }
  }
  { print }
' "$MSG_FILE" > "$tmp" 2>/dev/null && mv "$tmp" "$MSG_FILE" || rm -f "$tmp"
exit 0
