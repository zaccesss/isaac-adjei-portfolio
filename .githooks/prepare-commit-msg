#!/bin/sh
# Strips all Co-authored-by trailers so commits stay human-only (memory/RULES.md).
# One-time per clone: git config core.hooksPath .githooks

MSG_FILE=$1
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

tmp="${MSG_FILE}.$$.tmp"
awk '/^Co-authored-by:/ { next } { print }' "$MSG_FILE" > "$tmp" 2>/dev/null \
  && mv "$tmp" "$MSG_FILE" || rm -f "$tmp"
exit 0
