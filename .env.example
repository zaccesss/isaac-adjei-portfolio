# Site Configuration
# The canonical public URL of this site - used for absolute URL generation.
NEXT_PUBLIC_SITE_URL=https://isaacadjei.me

# Email - contact form (https://resend.com, free 3k/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Rate limiting - contact form (https://upstash.com, free tier available)
# Create a Redis database on Upstash, then copy the REST URL and token here.
# Without these the contact form still works but rate limiting is skipped.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Newsletter - subscriber signups (https://beehiiv.com)
BEEHIIV_API_KEY=your_beehiiv_api_key
BEEHIIV_PUBLICATION_ID=pub_xxxxxxxxxxxxxxxxxxxx

# Analytics (https://analytics.google.com)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Spotify - live now-playing status (https://developer.spotify.com)
# Create an app, add https://isaacadjei.me as redirect URI, run scripts/spotify-auth.mjs to get refresh token.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token


# GitHub - live activity widget (https://github.com/settings/tokens)
# Optional: without this only public repo pushes show. With it, private repos show too.
# Fine-grained PAT: All repositories, Contents read-only. Classic PAT: repo scope.
GITHUB_PAT=github_pat_xxxxxxxxxxxxxxxxxxxx

# Dashboard cron authentication (Vercel passes this automatically to cron routes)
CRON_SECRET=your_cron_secret_here

# Weekly digest email recipient
DIGEST_EMAIL=your@email.com

# GitHub PAT for triggering scraper from dashboard settings (optional)
GH_PAT=github_pat_xxxxxxxxxxxxxxxxxxxx

# I read my PSN NPSSO session token (64-char hex) from Sony's auth cookies.
# Expires after 60 days of inactivity - renew from playstation.com DevTools -> Cookies -> npsso.
PSN_NPSSO=

# IGDB cover art - used by the PS5 Cloudflare Worker and GPC daemon (https://dev.twitch.tv/console)
# Create a Twitch developer app, set redirect URL to http://localhost, then copy the client ID and generate a secret.
IGDB_CLIENT_ID=your_twitch_client_id
IGDB_CLIENT_SECRET=your_twitch_client_secret

# Steam Web API - GPC daemon only, for 5-tier game detection (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your_steam_api_key
# Steam64 ID - find at steamcommunity.com/id/[username] and convert via steamid.io
STEAM_ID=76561198xxxxxxxxx

# Job scraper - Discord webhook for daily new-job alerts (optional)
# Create a webhook in Discord server Settings -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Job scraper - Reed.co.uk API key (optional, free registration)
# Register at reed.co.uk/developers/jobseeker to get a key.
REED_API_KEY=

# Job scraper - Adzuna API credentials (optional, free trial 1000 req/month)
# Register at developer.adzuna.com.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Job scraper - Jooble API key (optional, free - request at jooble.org/api/about)
JOOBLE_API_KEY=

# WakaTime - coding activity heatmap (https://wakatime.com/settings/account -> API Key)
# GitHub Actions secret only - do NOT add to Vercel. The wakatime-sync.yml workflow runs in CI
# and writes daily stats to the wakatime_daily Supabase table. The dashboard reads from Supabase.
WAKATIME_API_KEY=

# Giscus blog comments (https://giscus.app)
# Set NEXT_PUBLIC_GISCUS_ENABLED=true to show the comments section on blog posts.
# Requires a public GitHub repo with Discussions enabled (zaccesss/isaac-adjei-portfolio-discussions).
# Get repoId and categoryId from https://giscus.app after setting up the repo.
NEXT_PUBLIC_GISCUS_ENABLED=false
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
