# Site Configuration
# The canonical public URL of this site - used for absolute URL generation.
NEXT_PUBLIC_SITE_URL=https://isaacadjei.me

# Email — contact form (https://resend.com, free 3k/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Rate limiting — contact form (https://upstash.com, free tier available)
# Create a Redis database on Upstash, then copy the REST URL and token here.
# Without these the contact form still works but rate limiting is skipped.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Newsletter — subscriber signups (https://beehiiv.com)
BEEHIIV_API_KEY=your_beehiiv_api_key
BEEHIIV_PUBLICATION_ID=pub_xxxxxxxxxxxxxxxxxxxx

# Analytics (https://analytics.google.com)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Spotify — live now-playing status (https://developer.spotify.com)
# Create an app, add https://isaacadjei.me as redirect URI, run scripts/spotify-auth.mjs to get refresh token.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# GitHub — live activity widget (https://github.com/settings/tokens)
# Optional: without this only public repo pushes show. With it, private repos show too.
# Fine-grained PAT: All repositories, Contents read-only. Classic PAT: repo scope.
GITHUB_PAT=github_pat_xxxxxxxxxxxxxxxxxxxx
